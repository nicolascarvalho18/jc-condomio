# Frontend: Supabase Auth. Configure these in Vercel too.
# The publishable key is browser-safe. Never add a secret/service-role key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<cole-a-chave-publicavel-do-supabase>
