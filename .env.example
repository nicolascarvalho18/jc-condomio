# ==============================================================================
# Variáveis de Ambiente - JC Condomínio (Construção Civil)
# Copie este arquivo para .env e preencha com as credenciais de produção
# ==============================================================================

# Banco de Dados PostgreSQL
# Para Supabase/produção, prefira usar SPRING_DATASOURCE_URL, usuário e senha
# diretamente nas variáveis secretas do provedor. Nunca versione esses valores.
# Exemplo de formato: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jccondomiodb
DB_USERNAME=jcuser
DB_PASSWORD=GERE_UMA_SENHA_FORTE_E_UNICA_AQUI

# Segurança e JWT (A chave secreta deve ter no mínimo 256 bits / 32 bytes)
JWT_SECRET=GERE_UMA_CHAVE_ALEATORIA_DE_NO_MINIMO_32_BYTES_AQUI
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS (Origens permitidas separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,https://jc-condomio.vercel.app

# Proteção contra Força Bruta (Rate Limiting)
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_MINUTES=15

# Porta da Aplicação Backend
PORT=8080
