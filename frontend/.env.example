# Supabase is the authentication provider for the deployed application.
# Use only the publishable/anon key here. Never use a secret/service-role key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Optional legacy Java API fallback for local development only.
VITE_API_BASE_URL=
